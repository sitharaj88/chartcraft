{
  "name": "chartcraft-monorepo",
  "private": true,
  "version": "0.4.0",
  "description": "ChartCraft — a world-class, framework-agnostic charting library for the web",
  "author": { "name": "Sitharaj", "url": "https://sitharaj.in" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/sitharaj88/chartcraft.git" },
  "homepage": "https://sitharaj88.github.io/chartcraft/",
  "bugs": "https://github.com/sitharaj88/chartcraft/issues",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @chartcraft/core && npm run build -w @chartcraft/react -w @chartcraft/vue -w @chartcraft/svelte -w @chartcraft/angular",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^4.2.19",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  }
}
