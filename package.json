{
  "name": "chartcraft-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "ChartCraft — a world-class, framework-agnostic charting library for the web",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @chartcraft/core && npm run build -w @chartcraft/react -w @chartcraft/vue -w @chartcraft/svelte",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsup": "^8.2.4",
    "vitest": "^2.1.9",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "^16.0.1",
    "vue": "^3.5.13",
    "svelte": "^4.2.19"
  },
  "engines": {
    "node": ">=18"
  }
}
