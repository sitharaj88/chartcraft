{
  "name": "@chartcraft/core",
  "version": "0.2.0",
  "description": "ChartCraft core — framework-agnostic charting engine (zero dependencies)",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsup bench/points.ts --format cjs --out-dir bench/dist --silent && node bench/dist/points.js"
  },
  "keywords": [
    "chart",
    "charts",
    "canvas",
    "visualization",
    "typescript"
  ]
}
