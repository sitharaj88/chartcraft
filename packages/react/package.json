{
  "name": "@chartcraft/react",
  "version": "0.3.0",
  "description": "ChartCraft React wrapper — thin lifecycle/event bridge around @chartcraft/core",
  "license": "MIT",
  "author": { "name": "Sitharaj", "url": "https://sitharaj.in" },
  "homepage": "https://sitharaj88.github.io/chartcraft/frameworks/react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitharaj88/chartcraft.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/sitharaj88/chartcraft/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chartcraft/core": "0.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "chart",
    "charts",
    "react",
    "visualization",
    "chartcraft"
  ]
}
