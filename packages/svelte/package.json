{
  "name": "@chartcraft/svelte",
  "version": "0.4.0",
  "description": "ChartCraft Svelte wrapper — thin lifecycle/event bridge around @chartcraft/core (ships source .svelte components)",
  "license": "MIT",
  "author": { "name": "Sitharaj", "url": "https://sitharaj.in" },
  "homepage": "https://sitharaj88.github.io/chartcraft/frameworks/svelte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitharaj88/chartcraft.git",
    "directory": "packages/svelte"
  },
  "bugs": "https://github.com/sitharaj88/chartcraft/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node -e \"console.log('@chartcraft/svelte ships source .svelte files (standard for Svelte libs) - no build step')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chartcraft/core": "0.4.0"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "devDependencies": {
    "svelte": "^4.2.19",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "chart",
    "charts",
    "svelte",
    "visualization",
    "chartcraft"
  ]
}
