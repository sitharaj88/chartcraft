{
  "name": "@chartcraft/vue",
  "version": "0.2.0",
  "description": "ChartCraft Vue 3 wrapper — thin lifecycle/event bridge around @chartcraft/core",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chartcraft/core": "0.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "vue": "^3.5.13"
  },
  "keywords": [
    "chart",
    "charts",
    "vue",
    "visualization",
    "chartcraft"
  ]
}
